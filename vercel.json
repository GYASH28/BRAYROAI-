{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/plans.html",
      "destination": "/plans",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/fakhrimart-case-study.html",
      "destination": "/clients/fakhrimart",
      "permanent": true
    },
    {
      "source": "/ae/plans.html",
      "destination": "/ae/plans",
      "permanent": true
    },
    {
      "source": "/ae/terms.html",
      "destination": "/ae/terms",
      "permanent": true
    },
    {
      "source": "/ae/fakhrimart-case-study.html",
      "destination": "/ae/clients/fakhrimart",
      "permanent": true
    },
    {
      "source": "/ae/clients.html",
      "destination": "/ae/#work",
      "permanent": true
    },
    {
      "source": "/ae/founder.html",
      "destination": "/ae/#studio",
      "permanent": true
    },
    {
      "source": "/ae/ai-workflow-audit.html",
      "destination": "/ae/plans#ai-audit",
      "permanent": true
    },
    {
      "source": "/ae/company-second-brain.html",
      "destination": "/ae/plans#second-brain",
      "permanent": true
    },
    {
      "source": "/au/plans.html",
      "destination": "/au/plans",
      "permanent": true
    },
    {
      "source": "/au/terms.html",
      "destination": "/au/terms",
      "permanent": true
    },
    {
      "source": "/au/fakhrimart-case-study.html",
      "destination": "/au/clients/fakhrimart",
      "permanent": true
    },
    {
      "source": "/au/clients.html",
      "destination": "/au/#work",
      "permanent": true
    },
    {
      "source": "/au/founder.html",
      "destination": "/au/#studio",
      "permanent": true
    },
    {
      "source": "/au/ai-workflow-audit.html",
      "destination": "/au/plans#ai-audit",
      "permanent": true
    },
    {
      "source": "/au/company-second-brain.html",
      "destination": "/au/plans#second-brain",
      "permanent": true
    },
    {
      "source": "/clients",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/founder",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/ai-workflow-audit",
      "destination": "/plans#ai-audit",
      "permanent": true
    },
    {
      "source": "/company-second-brain",
      "destination": "/plans#second-brain",
      "permanent": true
    },
    {
      "source": "/case-studies/fakhrimart",
      "destination": "/clients/fakhrimart",
      "permanent": true
    },
    {
      "source": "/clients.html",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/founder.html",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/ai-workflow-audit.html",
      "destination": "/plans#ai-audit",
      "permanent": true
    },
    {
      "source": "/company-second-brain.html",
      "destination": "/plans#second-brain",
      "permanent": true
    },
    {
      "source": "/case-studies/fakhrimart.html",
      "destination": "/clients/fakhrimart",
      "permanent": true
    },
    {
      "source": "/ae/ar",
      "destination": "/ae",
      "permanent": true
    },
    {
      "source": "/ae/ar/:path*",
      "destination": "/ae/:path*",
      "permanent": true
    },
    {
      "source": "/ae/clients",
      "destination": "/ae/#work",
      "permanent": true
    },
    {
      "source": "/au/clients",
      "destination": "/au/#work",
      "permanent": true
    },
    {
      "source": "/ae/founder",
      "destination": "/ae/#studio",
      "permanent": true
    },
    {
      "source": "/au/founder",
      "destination": "/au/#studio",
      "permanent": true
    },
    {
      "source": "/ae/ai-workflow-audit",
      "destination": "/ae/plans#ai-audit",
      "permanent": true
    },
    {
      "source": "/au/ai-workflow-audit",
      "destination": "/au/plans#ai-audit",
      "permanent": true
    },
    {
      "source": "/ae/company-second-brain",
      "destination": "/ae/plans#second-brain",
      "permanent": true
    },
    {
      "source": "/au/company-second-brain",
      "destination": "/au/plans#second-brain",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/plans",
      "destination": "/plans.html"
    },
    {
      "source": "/clients/fakhrimart",
      "destination": "/fakhrimart-case-study.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/ae",
      "destination": "/ae/index.html"
    },
    {
      "source": "/ae/plans",
      "destination": "/ae/plans/index.html"
    },
    {
      "source": "/ae/clients/fakhrimart",
      "destination": "/ae/clients/fakhrimart/index.html"
    },
    {
      "source": "/ae/terms",
      "destination": "/ae/terms/index.html"
    },
    {
      "source": "/au",
      "destination": "/au/index.html"
    },
    {
      "source": "/au/plans",
      "destination": "/au/plans/index.html"
    },
    {
      "source": "/au/clients/fakhrimart",
      "destination": "/au/clients/fakhrimart/index.html"
    },
    {
      "source": "/au/terms",
      "destination": "/au/terms/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' mailto:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
